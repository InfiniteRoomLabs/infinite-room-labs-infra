# Cloudflare — bootstrap token (manually created, "API Tokens Write" permission only)
CLOUDFLARE_BOOTSTRAP_API_TOKEN=

# Cloudflare — infra token (created by bootstrap, used by downstream resource groups)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Porkbun
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# Terraform Cloud
TF_TOKEN_app_terraform_io=
