# DEPRECATED -- secrets are now managed by fnox (Bitwarden-backed), not .env.
# Provider tokens are declared in fnox.toml and injected per-command via
# `fnox exec` / scripts/with-secrets.sh (no ambient loading, no .envrc).
# Non-secret identifiers (CLOUDFLARE_ACCOUNT_ID, DOCKER_USERNAME,
# TAILSCALE_TAILNET) live in mise.toml [env]. This file is retained only as a
# reference list of the variables the stack consumes.
#
# Cloudflare — bootstrap token (manually created, "API Tokens Write" permission only)
CLOUDFLARE_BOOTSTRAP_API_TOKEN=

# Cloudflare — infra token (created by bootstrap, used by downstream resource groups)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Porkbun
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# Terraform Cloud
TF_TOKEN_app_terraform_io=

# Docker Hub
DOCKER_USERNAME=
DOCKER_PASSWORD=

# DigitalOcean
DIGITAL_OCEAN_TOKEN=

# Tailscale
TAILSCALE_API_KEY=
TAILSCALE_TAILNET=

# Homelab
HOMELAB_TAILSCALE_IP=

# SendGrid
SENDGRID_API_KEY=

# Ansible vault password is NOT in .env -- it lives in .vault-password (gitignored)
# Setup: bw get notes ansible-vault-password > .vault-password
