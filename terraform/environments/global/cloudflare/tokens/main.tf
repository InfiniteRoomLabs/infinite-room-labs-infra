variable "bootstrap_api_token" {
  type        = string
  sensitive   = true
  description = "Cloudflare API token with 'API Tokens Write' permission"
}

variable "account_id" {
  type        = string
  description = "Cloudflare account ID"
}

provider "cloudflare" {
  api_token = var.bootstrap_api_token
}

