# Homelab Terraform environment variables.
# Loaded automatically by direnv when entering this directory.
#
# Secrets are read from ~/.secrets/ files.
# direnv keeps them in the shell session only -- never written to disk.

# ── Provider tokens ──────────────────────────────────────────────
export DIGITALOCEAN_TOKEN=$(cat ~/.secrets/.digital_ocean_api 2>/dev/null)
export CLOUDFLARE_ACCOUNT_ID=$(cat ~/.secrets/.cloudflare_create_tokens 2>/dev/null)

# ── SSH ──────────────────────────────────────────────────────────
export IRL_SSH_PUBKEY=$(cat ~/.ssh/id_ed25519.pub 2>/dev/null)
export DO_SSH_FINGERPRINT="72:f4:34:64:4f:2b:39:5a:56:d4:e5:0a:65:91:d3:31"

# ── k3s ──────────────────────────────────────────────────────────
export HOMELAB_TAILSCALE_IP="100.86.213.22"
export K3S_NODE_TOKEN=$(cat ~/.secrets/.k3s_node_token 2>/dev/null)
export TAILSCALE_AUTH_KEY=$(cat ~/.secrets/.ts_auth_key_homelab 2>/dev/null)

# ── Bitwarden provider ──────────────────────────────────────────
export BW_PASSWORD=${BW_PASSWORD:-}
export BW_CLIENT_ID=${BW_CLIENT_ID:-}
export BW_CLIENT_SECRET=${BW_CLIENT_SECRET:-}
