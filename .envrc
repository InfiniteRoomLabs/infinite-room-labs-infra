# Load environment variables from .env file (gitignored)
# Copy .env.example to .env and fill in your values
dotenv_if_exists .env

# Ansible vault password file (repo-local, gitignored)
# Setup: bw get notes ansible-vault-password > .vault-password
VAULT_PASS_FILE="$PWD/.vault-password"
if [[ ! -f "$VAULT_PASS_FILE" ]]; then
  log_error "Missing .vault-password -- run: bw get notes ansible-vault-password > .vault-password"
else
  export ANSIBLE_VAULT_PASSWORD_FILE="$VAULT_PASS_FILE"
fi

# Required environment variables:
#   CLOUDFLARE_BOOTSTRAP_API_TOKEN - Cloudflare token with "API Tokens Write" (bootstrap only)
#   CLOUDFLARE_API_TOKEN           - Cloudflare infra token (created by bootstrap)
#   CLOUDFLARE_ACCOUNT_ID          - Cloudflare account ID
#   PORKBUN_API_KEY         - Porkbun API key
#   PORKBUN_SECRET_KEY      - Porkbun API secret key
#   TF_TOKEN_app_terraform_io - Terraform Cloud API token
#   DOCKER_USERNAME           - Docker Hub username
#   DOCKER_PASSWORD           - Docker Hub password or access token
#   DIGITAL_OCEAN_TOKEN       - DigitalOcean API token
#   TAILSCALE_API_KEY         - Tailscale API key (from BW: tailscale-api-key)
#   TAILSCALE_TAILNET         - Tailscale tailnet name (org name or domain)
#   SENDGRID_API_KEY          - SendGrid API key (from BW: sendgrid-api-key)

env_vars_required CLOUDFLARE_BOOTSTRAP_API_TOKEN CLOUDFLARE_API_TOKEN CLOUDFLARE_ACCOUNT_ID PORKBUN_API_KEY PORKBUN_SECRET_KEY TF_TOKEN_app_terraform_io DOCKER_USERNAME DOCKER_PASSWORD DIGITAL_OCEAN_TOKEN TAILSCALE_API_KEY TAILSCALE_TAILNET SENDGRID_API_KEY

