# Load environment variables from .env file (gitignored)
# Copy .env.example to .env and fill in your values
dotenv_if_exists .env

# Required environment variables:
#   CLOUDFLARE_BOOTSTRAP_API_TOKEN - Cloudflare token with "API Tokens Write" (bootstrap only)
#   CLOUDFLARE_API_TOKEN           - Cloudflare infra token (created by bootstrap)
#   CLOUDFLARE_ACCOUNT_ID          - Cloudflare account ID
#   PORKBUN_API_KEY         - Porkbun API key
#   PORKBUN_SECRET_KEY      - Porkbun API secret key
#   TF_TOKEN_app_terraform_io - Terraform Cloud API token

