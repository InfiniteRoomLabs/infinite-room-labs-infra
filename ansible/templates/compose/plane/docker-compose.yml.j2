# Managed by Ansible -- do not edit manually
# Plane project management stack
# Plane has its own Redis and MinIO in addition to the shared PostgreSQL.

services:
  plane-web:
    image: makeplane/plane-frontend:stable
    container_name: irl-plane-web
    restart: unless-stopped
    ports:
      - "127.0.0.1:8082:3000"
    networks:
      - irl-frontend
    deploy:
      resources:
        limits:
          memory: {{ irl_mem_limits.plane_web }}
    depends_on:
      plane-api:
        condition: service_healthy
    command: node web/server.js web

  plane-api:
    image: makeplane/plane-backend:stable
    container_name: irl-plane-api
    restart: unless-stopped
    environment:
      - DATABASE_URL=postgresql://plane:{{ vault_pg_passwords.plane }}@irl-postgres:5432/plane
      - REDIS_URL=redis://:{{ vault_redis_password }}@irl-redis:6379/1
      - SECRET_KEY={{ vault_plane_secret_key }}
      - MINIO_ROOT_USER=plane
      - MINIO_ROOT_PASSWORD={{ vault_plane_minio_password }}
      - USE_MINIO=1
      - AWS_S3_ENDPOINT_URL=http://plane-minio:9000
      - AWS_ACCESS_KEY_ID=plane
      - AWS_SECRET_ACCESS_KEY={{ vault_plane_minio_password }}
      - AWS_S3_BUCKET_NAME=plane-uploads
    ports:
      - "127.0.0.1:8083:8000"
    networks:
      - irl-frontend
      - irl-backend
    deploy:
      resources:
        limits:
          memory: {{ irl_mem_limits.plane_api }}
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/')"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    command: ./bin/docker-entrypoint-api.sh

  plane-worker:
    image: makeplane/plane-backend:stable
    container_name: irl-plane-worker
    restart: unless-stopped
    environment:
      - DATABASE_URL=postgresql://plane:{{ vault_pg_passwords.plane }}@irl-postgres:5432/plane
      - REDIS_URL=redis://:{{ vault_redis_password }}@irl-redis:6379/1
      - SECRET_KEY={{ vault_plane_secret_key }}
      - USE_MINIO=1
      - AWS_S3_ENDPOINT_URL=http://plane-minio:9000
      - AWS_ACCESS_KEY_ID=plane
      - AWS_SECRET_ACCESS_KEY={{ vault_plane_minio_password }}
      - AWS_S3_BUCKET_NAME=plane-uploads
    networks:
      - irl-backend
    deploy:
      resources:
        limits:
          memory: {{ irl_mem_limits.plane_worker }}
    command: ./bin/docker-entrypoint-worker.sh

  plane-minio:
    image: minio/minio:RELEASE.2024-07-16T23-46-41Z
    container_name: irl-plane-minio
    restart: unless-stopped
    environment:
      - MINIO_ROOT_USER=plane
      - MINIO_ROOT_PASSWORD={{ vault_plane_minio_password }}
    volumes:
      - plane_minio_data:/data
    networks:
      - irl-backend
    deploy:
      resources:
        limits:
          memory: {{ irl_mem_limits.plane_minio }}
    command: server /data
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 30s
      timeout: 5s
      retries: 5

volumes:
  plane_minio_data:

networks:
  irl-frontend:
    external: true
  irl-backend:
    external: true
