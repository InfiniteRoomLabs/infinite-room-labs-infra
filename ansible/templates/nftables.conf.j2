#!/usr/sbin/nft -f
# Managed by Ansible -- do not edit manually
# Infinite Room Labs homelab firewall (nftables)
#
# Policy: default deny inbound, allow established, allow specific ports.
# Tailscale traffic is always allowed (interface-based).

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;

        # Allow loopback
        iif "lo" accept

        # Allow established/related connections
        ct state established,related accept

        # Drop invalid packets
        ct state invalid drop

        # Allow ICMP (ping, path MTU discovery)
        ip protocol icmp accept
        ip6 nexthdr icmpv6 accept

        # Allow trusted internal interfaces unconditionally
        iifname "tailscale0" accept
        iifname "cni0" accept
        iifname "flannel.1" accept

        # Allow specific TCP ports from any interface
{% for port in irl_firewall_allowed_tcp_ports %}
        tcp dport {{ port }} accept
{% endfor %}

        # Log dropped packets (rate limited)
        limit rate 5/minute burst 5 packets log prefix "nftables-dropped: " level info
    }

    chain forward {
        type filter hook forward priority filter; policy accept;

        # Docker manages its own forwarding rules via iptables.
        # nftables iifname does NOT support wildcards ("docker*" matches
        # nothing). Setting policy accept and letting Docker's iptables
        # DOCKER-USER chain handle forwarding is the correct coexistence
        # pattern. The input chain still default-denies inbound traffic.

        ct state established,related accept

        # Allow Tailscale forwarding if subnet routing is enabled later
        iifname "tailscale0" accept
        oifname "tailscale0" accept
    }

    chain output {
        type filter hook output priority filter; policy accept;

        # Compensating controls for Caddy hostNetwork pod (UID 1000).
        # hostNetwork pods bypass k8s NetworkPolicy, so we restrict
        # outbound at the nftables level.
        #
        # Allow Caddy -> k8s ClusterIP CIDR (upstream services)
        meta skuid 1000 ip daddr 10.43.0.0/16 accept
        # Allow Caddy -> pod CIDR (for direct pod routing)
        meta skuid 1000 ip daddr 10.42.0.0/16 accept
        # Allow Caddy -> DNS (cluster DNS + public resolvers for ACME)
        meta skuid 1000 udp dport 53 accept
        meta skuid 1000 tcp dport 53 accept
        # Allow Caddy -> HTTPS (Cloudflare API + LE ACME servers)
        meta skuid 1000 tcp dport 443 accept
        # Allow Caddy -> loopback (admin API health probes)
        meta skuid 1000 oif "lo" accept
        # Drop all other outbound from Caddy
        meta skuid 1000 log prefix "caddy-blocked: " level info drop
    }
}
