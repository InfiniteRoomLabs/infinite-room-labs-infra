# Managed by Ansible -- do not edit manually
# Alertmanager configuration
#
# Routes alerts to webhook endpoints that agents can consume.
# No email or PagerDuty -- agent-first alerting.

global:
  resolve_timeout: 5m

route:
  group_by: ["alertname", "severity"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: "default"

  routes:
    - match:
        severity: critical
      receiver: "critical"
      repeat_interval: 1h

    - match:
        severity: warning
      receiver: "default"
      repeat_interval: 4h

receivers:
  - name: "default"
    # Webhook for agent consumption -- configure endpoint when MCP servers are ready
    # webhook_configs:
    #   - url: "http://localhost:9095/alertmanager/webhook"
    #     send_resolved: true

  - name: "critical"
    # Critical alerts get same webhook but with higher priority
    # webhook_configs:
    #   - url: "http://localhost:9095/alertmanager/webhook?priority=critical"
    #     send_resolved: true

inhibit_rules:
  - source_match:
      severity: "critical"
    target_match:
      severity: "warning"
    equal: ["alertname", "instance"]
