# {{ ansible_managed }}
# Infinite Room Labs homelab reverse proxy
#
# All services are proxied through Caddy on the Tailscale interface.
# Public services use ACME (Let's Encrypt) for valid TLS.
# Internal services use Caddy's internal CA (self-signed).

# Global options
{
	# Admin API on localhost only (needed for caddy reload)
	admin localhost:2019
}

{% for svc_name, svc in irl_services.items() %}
{% if svc.get('caddy_proxy', true) and svc_name != 'plane' %}
{% set domain = irl_internal_domain if svc.internal else irl_public_domain %}
# {{ svc_name | capitalize }}{{ " (internal)" if svc.internal else "" }}
{{ svc.subdomain }}.{{ domain }} {
	tls internal
	reverse_proxy localhost:{{ svc.port }}
	log {
		output file /var/log/caddy/{{ svc_name }}.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}

{% endif %}
{% endfor %}
# Plane -- path-based routing to multiple backends
plane.{{ irl_public_domain }} {
	tls internal
	handle /api/* {
		reverse_proxy localhost:30083
	}
	handle /spaces/* {
		reverse_proxy localhost:30084
	}
	handle /god-mode/* {
		reverse_proxy localhost:30085
	}
	handle /live/* {
		reverse_proxy localhost:30086
	}
	handle {
		reverse_proxy localhost:30082
	}
	log {
		output file /var/log/caddy/plane.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
