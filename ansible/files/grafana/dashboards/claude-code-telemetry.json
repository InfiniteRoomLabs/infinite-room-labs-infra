{
  "id": null,
  "uid": "claude-code-telemetry",
  "title": "Claude Code Telemetry",
  "description": "Claude Code observability: tokens, cost, sessions, code edits, and logs",
  "tags": ["claude-code", "otel", "irl"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" },
        "hide": 0
      },
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "current": { "text": "Loki", "value": "Loki" },
        "hide": 0
      },
      {
        "name": "tempo",
        "type": "datasource",
        "query": "tempo",
        "current": { "text": "Tempo", "value": "Tempo" },
        "hide": 0
      },
      {
        "name": "model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(claude_code_token_usage_tokens_total, model)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "hide": 0,
        "label": "Model",
        "regex": ""
      },
      {
        "name": "session_id",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(claude_code_session_count_total, session_id)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "hide": 0,
        "label": "Session",
        "sort": 2,
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sessions",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "count(claude_code_session_count_total{session_id=~\"$session_id\"})", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }] } } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Cost",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "sum(claude_code_cost_usage_USD_total{model=~\"$model\", session_id=~\"$session_id\"})", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] } } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Input Tokens",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "sum(claude_code_token_usage_tokens_total{type=\"input\", model=~\"$model\", session_id=~\"$session_id\"})", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "purple", "value": null }] } } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Output Tokens",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "sum(claude_code_token_usage_tokens_total{type=\"output\", model=~\"$model\", session_id=~\"$session_id\"})", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "orange", "value": null }] } } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Active Time",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "sum(claude_code_active_time_seconds_total{type=\"cli\", session_id=~\"$session_id\"})", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } } }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Lines Changed",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(claude_code_lines_of_code_count_total{type=\"added\", session_id=~\"$session_id\"})", "legendFormat": "+added", "refId": "A" },
        { "expr": "sum(claude_code_lines_of_code_count_total{type=\"removed\", session_id=~\"$session_id\"})", "legendFormat": "-removed", "refId": "B" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } }, "overrides": [{ "matcher": { "id": "byName", "options": "-removed" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }] }
    },

    {
      "id": 10,
      "type": "row",
      "title": "Token Usage & Cost",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Token Rate by Type",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (type) (rate(claude_code_token_usage_tokens_total{model=~\"$model\", session_id=~\"$session_id\"}[5m])) * 60", "legendFormat": "{{type}}", "refId": "A" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "mean", "max"] } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "gradientMode": "scheme", "stacking": { "mode": "none" }, "spanNulls": true, "showPoints": "auto", "pointSize": 4 }, "color": { "mode": "palette-classic" } }, "overrides": [
        { "matcher": { "id": "byName", "options": "input" }, "properties": [{ "id": "color", "value": { "fixedColor": "#8F3BB8", "mode": "fixed" } }] },
        { "matcher": { "id": "byName", "options": "output" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }] },
        { "matcher": { "id": "byName", "options": "cacheRead" }, "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
        { "matcher": { "id": "byName", "options": "cacheCreation" }, "properties": [{ "id": "color", "value": { "fixedColor": "#5794F2", "mode": "fixed" } }] }
      ] }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Cost Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (model) (rate(claude_code_cost_usage_USD_total{model=~\"$model\", session_id=~\"$session_id\"}[5m])) * 3600", "legendFormat": "{{model}} $/hr", "refId": "A" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "mean", "max"] } },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 3, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "gradientMode": "scheme", "spanNulls": true, "showPoints": "auto" }, "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 13,
      "type": "piechart",
      "title": "Tokens by Model",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "sum by (model) (claude_code_token_usage_tokens_total{model=~\"$model\", session_id=~\"$session_id\"})", "legendFormat": "{{model}}", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }, "pieType": "donut" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 14,
      "type": "piechart",
      "title": "Token Type Breakdown",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "sum by (type) (claude_code_token_usage_tokens_total{model=~\"$model\", session_id=~\"$session_id\"})", "legendFormat": "{{type}}", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }, "pieType": "donut" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 15,
      "type": "bargauge",
      "title": "Cost by Session",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "topk(10, sum by (session_id) (claude_code_cost_usage_USD_total{model=~\"$model\", session_id=~\"$session_id\"}))", "legendFormat": "{{session_id}}", "refId": "A", "instant": true }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "continuous-GrYlRd" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } } }
    },

    {
      "id": 20,
      "type": "row",
      "title": "Code Edits & Activity",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }
    },
    {
      "id": 21,
      "type": "barchart",
      "title": "Edit Decisions by Tool & Language",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "sum by (tool_name, language) (claude_code_code_edit_tool_decision_total{session_id=~\"$session_id\"})", "legendFormat": "{{tool_name}} ({{language}})", "refId": "A", "instant": true, "format": "table" }],
      "options": { "orientation": "horizontal", "barWidth": 0.8, "showValue": "always", "legend": { "displayMode": "list", "placement": "right" } },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Lines of Code Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(rate(claude_code_lines_of_code_count_total{type=\"added\", session_id=~\"$session_id\"}[5m])) * 60", "legendFormat": "+added/min", "refId": "A" },
        { "expr": "-sum(rate(claude_code_lines_of_code_count_total{type=\"removed\", session_id=~\"$session_id\"}[5m])) * 60", "legendFormat": "-removed/min", "refId": "B" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "stacking": { "mode": "none" } }, "color": { "mode": "palette-classic" } }, "overrides": [
        { "matcher": { "id": "byName", "options": "+added/min" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
        { "matcher": { "id": "byName", "options": "-removed/min" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
      ] }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Active Time (CLI vs User)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (type) (rate(claude_code_active_time_seconds_total{session_id=~\"$session_id\"}[5m])) * 60", "legendFormat": "{{type}} sec/min", "refId": "A" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "mean"] } },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 30, "stacking": { "mode": "normal" }, "spanNulls": true }, "color": { "mode": "palette-classic" } }, "overrides": [
        { "matcher": { "id": "byName", "options": "cli sec/min" }, "properties": [{ "id": "color", "value": { "fixedColor": "#5794F2", "mode": "fixed" } }] },
        { "matcher": { "id": "byName", "options": "user sec/min" }, "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] }
      ] }
    },
    {
      "id": 24,
      "type": "table",
      "title": "Session Summary",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum by (session_id, model) (claude_code_cost_usage_USD_total{model=~\"$model\", session_id=~\"$session_id\"})", "legendFormat": "", "refId": "A", "instant": true, "format": "table" }
      ],
      "options": { "sortBy": [{ "displayName": "Value", "desc": true }] },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 } },
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true } } }]
    },

    {
      "id": 30,
      "type": "row",
      "title": "Logs & Traces",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 }
    },
    {
      "id": 31,
      "type": "logs",
      "title": "Claude Code Events",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 40 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "targets": [{ "expr": "{service_name=\"claude-code\"} | json", "refId": "A" }],
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none" }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Log Volume",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 50 },
      "datasource": { "type": "loki", "uid": "${loki}" },
      "targets": [{ "expr": "sum(count_over_time({service_name=\"claude-code\"}[5m]))", "legendFormat": "events/5m", "refId": "A" }],
      "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "gradientMode": "scheme" }, "color": { "fixedColor": "blue", "mode": "fixed" } } }
    },
    {
      "id": 33,
      "type": "traces",
      "title": "Recent Traces",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 50 },
      "datasource": { "type": "tempo", "uid": "${tempo}" },
      "targets": [{ "query": "{resource.service.name=\"claude-code\"}", "queryType": "traceql", "refId": "A", "limit": 20 }]
    }
  ]
}
