{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "ZFS Pool Usage",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "(node_zfs_arc_size / node_zfs_arc_max) * 100",
          "legendFormat": "ARC Usage %"
        }
      ]
    },
    {
      "title": "ZFS ARC Hit Rate",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(node_zfs_arc_hits[5m]) / (rate(node_zfs_arc_hits[5m]) + rate(node_zfs_arc_misses[5m])) * 100",
          "legendFormat": "ARC Hit Rate %"
        }
      ]
    },
    {
      "title": "Filesystem Usage by Mountpoint",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "(1 - (node_filesystem_avail_bytes{fstype=\"zfs\"} / node_filesystem_size_bytes{fstype=\"zfs\"})) * 100",
          "legendFormat": "{{ mountpoint }}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["homelab", "zfs"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "title": "ZFS Health",
  "uid": "irl-zfs-health"
}
