# docker/agent-box/.env.example
# Copy to `.env` (git-ignored) to set interpolation values for compose.yaml
# when running `docker compose` directly. The host wrapper derives the
# starred ones itself, so with `./agent-box.sh compose ...` or `task ...`
# you usually need nothing here.
#
# Precedence: shell environment > .env > the defaults in compose.yaml.

# Where your repos live on the host; mounted at /work.
#AGENT_BOX_WORKSPACE=~/Projects

# Working directory inside the box (the infra repo under /work, typically).  *derived
#AGENT_BOX_REPO_DIR=/work/infinite-room-labs-infra

# SSH target the box's ~/.ssh/config calls `homelab-ts`.  *derived from
# ansible/inventory/hosts.ini (ansible_user) and mise.toml (HOMELAB_TAILSCALE_IP)
#AGENT_BOX_SSH_USER=
#AGENT_BOX_SSH_HOST=

# Optional Gitea SSH host to add to the box's ssh config, and its port.
#AGENT_BOX_GIT_HOST=
#AGENT_BOX_GIT_SSH_PORT=30022

# Commit identity inside the box.  *derived from the host's git config
# (user.name / user.email); if both are empty the box uses its gh login.
#AGENT_BOX_GIT_NAME=
#AGENT_BOX_GIT_EMAIL=

# 1 = apply the egress denylist from image/denylist.txt (default), 0 = no firewall.
#AGENT_BOX_FIREWALL=1

#AGENT_BOX_TZ=America/New_York
#AGENT_BOX_IMAGE=irl-agent-box:local
# The home volume is declared `external` in compose.yaml. The wrapper creates
# it; for direct compose use run `docker volume create irl-agent-box-home` once.
#AGENT_BOX_VOLUME=irl-agent-box-home

# compose.scoped.yaml (batch/mcp with one directory mounted) needs both of
# these; `agent-box.sh batch|mcp` sets them from --dir. Only for direct use.
#AGENT_BOX_MOUNT_SRC=/home/you/Projects/some-repo
#AGENT_BOX_MOUNT_DST=/work/some-repo

# Make an overlay stack sticky for this checkout (colon-separated on Linux/macOS).
#COMPOSE_FILE=compose.yaml:compose.open.yaml
